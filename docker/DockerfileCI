# Builds dpaste against the CI environment provided by DockerfileBase.
# Build the base image first, e.g.:
#   docker build -t dpaste-ci-base -f docker/DockerfileBase .
#   docker build -t dpaste-ci -f docker/DockerfileCI .
FROM dpaste-ci-base
LABEL maintainer="Simon Désaulniers <sim.desaulniers@gmail.com>"
COPY . /root/dpaste
RUN cd /root/dpaste \
    && ./autogen.sh \
    && ./configure --enable-tests \
    && make -j"$(nproc)" \
    && make install

